[Unit]
Description=MeshCore AI Agent
After=network.target
Wants=network.target

[Service]
Type=simple
User=wallscreet
WorkingDirectory=/home/wallscreet/mcagent
ExecStart=/home/wallscreet/.venv/bin/python /home/wallscreet/mcagent/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target